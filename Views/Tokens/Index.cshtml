@model IEnumerable<NexusAuth.Models.ApiToken>
@{
    ViewData["Title"] = "API Tokens";
    var apps = ViewBag.Applications as List<NexusAuth.Models.Application> ?? new List<NexusAuth.Models.Application>();
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">API Key & Token Management</h2>
        <p class="text-secondary small">Issue, rotate, and revoke API secrets with granular permission scopes.</p>
    </div>
    <div>
        <button class="btn btn-outline-info me-2" data-bs-toggle="modal" data-bs-target="#createAppModal">+ Register App</button>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTokenModal">+ Issue Token</button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Tokens List Table (8 <th> headers matching 8 <td> cells) -->
<div class="card p-3">
    <div class="table-responsive">
        <table id="tokensTable" class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Token Name</th>
                    <th>Application</th>
                    <th>Key Prefix</th>
                    <th>Allowed Scopes</th>
                    <th>Rate Limit</th>
                    <th>Status</th>
                    <th>IP Allowlist</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in Model)
                {
                    <tr>
                        <td class="fw-semibold">@token.TokenName</td>
                        <td><span class="badge bg-secondary">@token.Application?.AppName</span></td>
                        <td><code>@token.KeyPrefix...</code></td>
                        <td class="small text-info">@token.AllowedScopes</td>
                        <td class="small text-secondary">@token.RateLimitPerMinute req/min</td>
                        <td>
                            @if (token.IsRevoked)
                            {
                                <span class="badge bg-danger">Revoked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(token.AllowedIpAddresses))
                            {
                                <span class="badge bg-success-subtle text-success border border-success" title="@token.AllowedIpAddresses">
                                    IP Locked (@token.AllowedIpAddresses.Split(',').Length)
                                </span>
                                <div class="small text-secondary mt-1">@token.AllowedIpAddresses</div>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Any IP</span>
                            }
                        </td>
                        <td>
                            @if (!token.IsRevoked)
                            {
                                <button type="button" class="btn btn-outline-info btn-sm me-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editIpsModal"
                                        data-token-id="@token.TokenId"
                                        data-token-name="@token.TokenName"
                                        data-allowed-ips="@token.AllowedIpAddresses">
                                    IPs
                                </button>

                                <form asp-action="RotateToken" method="post" class="d-inline">
                                    <input type="hidden" name="oldTokenId" value="@token.TokenId" />
                                    <input type="hidden" name="newTokenName" value="@(token.TokenName) (Rotated)" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm">Rotate</button>
                                </form>

                                <form asp-action="RevokeToken" method="post" class="d-inline ms-1" onsubmit="return confirm('Are you sure you want to revoke this API key?');">
                                    <input type="hidden" name="tokenId" value="@token.TokenId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Revoke</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-secondary small">Disabled</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Register Application -->
<div class="modal fade" id="createAppModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Register Tenant Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateApp" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Application Name</label>
                        <input type="text" name="appName" class="form-control bg-secondary text-light border-0" placeholder="e.g. Mobile App Gateway" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Description</label>
                        <input type="text" name="description" class="form-control bg-secondary text-light border-0" placeholder="Purpose of this app..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Environment</label>
                        <select name="environment" class="form-select bg-secondary text-light border-0">
                            <option value="Production">Production</option>
                            <option value="Staging">Staging</option>
                            <option value="Development">Development</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info">Save Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Issue Token -->
<div class="modal fade" id="createTokenModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Issue New API Secret Token</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateToken" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Target Application</label>
                        <select name="applicationId" class="form-select bg-secondary text-light border-0" required>
                            @foreach (var app in apps)
                            {
                                <option value="@app.ApplicationId">@app.AppName (@app.Environment)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Token Identifier Name</label>
                        <input type="text" name="tokenName" class="form-control bg-secondary text-light border-0" placeholder="e.g. Payment Webhook Key" required />
                    </div>
                    @if (User.IsInRole("Customer"))
                    {
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Allowed Scopes (Customer Tier)</label>
                            <input type="text" name="scopes" class="form-control bg-black text-info border-secondary" value="read:data" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Rate Limit (Max 100 req/min on Customer Tier)</label>
                            <input type="number" name="rateLimit" class="form-control bg-secondary text-light border-0" value="100" min="1" max="100" required />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Allowed Scopes (Comma-separated)</label>
                            <input type="text" name="scopes" class="form-control bg-secondary text-light border-0" value="read:data,write:data" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Rate Limit (Requests/Minute)</label>
                            <input type="number" name="rateLimit" class="form-control bg-secondary text-light border-0" value="1000" required />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Server IP Allowlist (Optional, comma-separated)</label>
                        <input type="text" name="allowedIps" class="form-control bg-secondary text-light border-0" placeholder="e.g., 127.0.0.1, 203.177.42.18 (Leave blank for any IP)" />
                        <div class="form-text text-secondary small">Only requests originating from these server IPs will be accepted.</div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate API Token</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Manage Server IP Allowlist -->
<div class="modal fade" id="editIpsModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="UpdateTokenIps" method="post" class="modal-content bg-dark text-light border-secondary">
            @Html.AntiForgeryToken()
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Manage Server IP Allowlist</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="tokenId" id="editIpTokenId" />
                <p class="small text-secondary">Token: <strong id="editIpTokenName" class="text-light"></strong></p>
                <div class="mb-3">
                    <label class="form-label small text-secondary">Allowed Server IPs (comma-separated)</label>
                    <input type="text" name="allowedIps" id="editIpListInput" class="form-control bg-secondary text-light border-0" placeholder="e.g., 127.0.0.1, 10.0.0.5" />
                    <div class="form-text text-secondary small">Leave blank to allow requests from any IP address.</div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-info">Save IP Allowlist</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Display Generated Raw Secret (Shown ONCE) -->
@if (ViewBag.NewRawToken != null)
{
    <div class="modal fade" id="rawTokenModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-light border-success">
                <div class="modal-header border-success">
                    <h5 class="modal-title text-success fw-bold">Token Created Successfully</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary mb-2">Please copy your raw API secret key now. <strong>You will not be able to see it again!</strong></p>
                    <div class="input-group">
                        <input type="text" id="rawTokenInput" class="form-control bg-black text-warning font-monospace border-secondary" value="@ViewBag.NewRawToken" readonly />
                        <button class="btn btn-outline-success" onclick="copyToken()">Copy</button>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">Done</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tokensTable').DataTable({
                order: [[5, 'asc']]
            });

            @if (ViewBag.NewRawToken != null)
            {
                <text>
                var tokenModal = new bootstrap.Modal(document.getElementById('rawTokenModal'));
                tokenModal.show();
                </text>
            }
        });

        document.getElementById('editIpsModal')?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editIpTokenId').value = btn.getAttribute('data-token-id');
            document.getElementById('editIpTokenName').textContent = btn.getAttribute('data-token-name');
            document.getElementById('editIpListInput').value = btn.getAttribute('data-allowed-ips') || '';
        });

        function copyToken() {
            var copyText = document.getElementById("rawTokenInput");
            copyText.select();
            navigator.clipboard.writeText(copyText.value);
            alert("API Key copied to clipboard!");
        }
    </script>
}