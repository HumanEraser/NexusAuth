@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5 text-center">
    <div class="card p-5 border-danger shadow-lg style="max-width: 520px; width: 100%;">
        <div class="mb-3">
            <span class="display-1 text-danger">🛡️</span>
        </div>
        <h2 class="fw-bold text-danger mb-2">403 - Access Denied</h2>
        <p class="text-secondary mb-4">
            Your current account role does not have permission to access this administrative feature or execute actions on this resource.
        </p>
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 py-2">
                ← Return to Dashboard
            </a>
        </div>
    </div>
</div>