@model IEnumerable<System.IO.FileInfo>
@{
    ViewData["Title"] = "Database Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Database Administration & Health</h2>
        <p class="text-secondary small">Monitor storage metrics and execute full T-SQL database backups.</p>
    </div>
    <form asp-action="CreateBackup" method="post">
        <button type="submit" class="btn btn-primary">⚡ Execute DB Backup (.bak)</button>
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3">
            <span class="text-secondary small fw-semibold">Target Database</span>
            <h4 class="fw-bold text-info mt-2 mb-0">@ViewBag.DatabaseName</h4>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <span class="text-secondary small fw-semibold">Allocated Storage Size</span>
            <h4 class="fw-bold text-success mt-2 mb-0">@ViewBag.DatabaseSize MB</h4>
        </div>
    </div>
</div>

<div class="card p-3">
    <h6 class="fw-bold mb-3 text-white">Backup Archive History</h6>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Backup File Name</th>
                    <th>Size (MB)</th>
                    <th>Created Timestamp</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var file in Model)
                    {
                        <tr>
                            <td class="fw-semibold"><code>@file.Name</code></td>
                            <td class="text-secondary small">@(Math.Round((double)file.Length / (1024 * 1024), 2)) MB</td>
                            <td class="small text-secondary">@file.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-success">Verified (.bak)</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">No backups generated yet. Click "Execute DB Backup" to trigger a T-SQL backup.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>